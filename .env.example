# All integrations are optional for local demonstration.
# Without AI config, the app uses a truthful local template generator.
# Without Supabase config, merchant seeds remain available and research data is not persisted.
AI_API_KEY=
# DeepSeek example: https://api.deepseek.com
AI_BASE_URL=
# DeepSeek example: deepseek-v4-flash
AI_MODEL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Never expose this key through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
